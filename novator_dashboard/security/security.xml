<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_ndash" model="ir.module.category">
        <field name="name">Dashboards</field>
        <field name="sequence">92</field>
    </record>
    <record id="privilege_ndash" model="res.groups.privilege">
        <field name="name">Dashboards</field>
        <field name="category_id" ref="module_category_ndash"/>
    </record>
    <record id="group_ndash_user" model="res.groups">
        <field name="name">User: view shared dashboards</field>
        <field name="privilege_id" ref="privilege_ndash"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
    <record id="group_ndash_manager" model="res.groups">
        <field name="name">Administrator: create and edit dashboards</field>
        <field name="privilege_id" ref="privilege_ndash"/>
        <field name="implied_ids" eval="[(4, ref('group_ndash_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_ndash_user'))]"/>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_ndash_manager'))]"/>
    </record>

    <data noupdate="1">
        <record id="rule_dashboard_user" model="ir.rule">
            <field name="name">Dashboards: shared with me</field>
            <field name="model_id" ref="model_ndash_dashboard"/>
            <field name="domain_force">['|', '|', '&amp;', ('group_ids', '=', False), ('user_ids', '=', False), ('user_ids', 'in', [user.id]), ('group_ids', 'in', user.all_group_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('group_ndash_user'))]"/>
        </record>
        <record id="rule_dashboard_manager" model="ir.rule">
            <field name="name">Dashboards: all</field>
            <field name="model_id" ref="model_ndash_dashboard"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_ndash_manager'))]"/>
        </record>
        <record id="rule_item_user" model="ir.rule">
            <field name="name">Dashboard items: shared with me</field>
            <field name="model_id" ref="model_ndash_item"/>
            <field name="domain_force">['|', '|', '&amp;', ('dashboard_id.group_ids', '=', False), ('dashboard_id.user_ids', '=', False), ('dashboard_id.user_ids', 'in', [user.id]), ('dashboard_id.group_ids', 'in', user.all_group_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('group_ndash_user'))]"/>
        </record>
        <record id="rule_item_manager" model="ir.rule">
            <field name="name">Dashboard items: all</field>
            <field name="model_id" ref="model_ndash_item"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_ndash_manager'))]"/>
        </record>
    </data>
</odoo>
